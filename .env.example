# ── Local PostgreSQL (Docker Compose) ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=streamlit_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_KEY=replace_with_32_byte_hex

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=local
AGENT_CLI_URL=

# ── GCP (auto-populated by Terraform / Cloud Run in deployed environments) ────
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_BUCKET_NAME=
CLOUD_SQL_CONNECTION_NAME=

# ── Assembled by Docker Compose / Cloud Run (leave blank for local non-Docker) ─
DATABASE_URL=
ASYNC_DATABASE_URL=
